# Copiá este archivo como .env y completalo. Nunca lo subas a GitHub.

# Clave de la API de Claude (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Contraseña que vas a poner en FamLog (Configuración → Lectura con IA). Inventá una larga.
FAMLOG_CLAVE=cambiame-por-una-frase-larga

# Puerto local del servidor
PORT=8787

# Desde dónde se permite usarlo (la app publicada). Separá varios con coma.
FAMLOG_ORIGENES=https://arehermann.github.io

# Modelo de Claude. claude-opus-5-5 lee mejor la letra difícil; claude-sonnet-5-5 o
# claude-haiku-5-5 cuestan menos.
FAMLOG_MODELO=claude-opus-5-5

# Tope de documentos por día, para que un error no te genere gastos
FAMLOG_MAX_DIA=40
